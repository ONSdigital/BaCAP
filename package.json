{
	"name": "@onsvisual/sveltekit-starter",
	"homepage": "http://onsdigital.github.io/sveltekit-starter",
	"version": "1.0.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node ./scripts/js-fix",
		"build:preview": "cross-env PUBLIC_APP_ENV=preview vite build",
		"package": "vite package",
		"preview": "vite preview",
		"deploy": "gh-pages -d build -t true",
		"data:compress": "node ./scripts/compress-data.js",
		"lint": "prettier --ignore-path .gitignore --check --plugin-search-dir=. .",
		"format": "prettier --ignore-path .gitignore --write --plugin-search-dir=. ."
	},
	"author": "Ahmad Barclay",
	"license": "MIT",
	"devDependencies": {
		"@mapbox/mapbox-gl-draw": "^1.4.3",
		"@mapbox/tilebelt": "^2.0.3",
		"@onsvisual/svelte-components": "^1.1.30",
		"@onsvisual/svelte-maps": "^1.2.28",
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"@turf/area": "^7.3.5",
		"@turf/bbox": "^7.3.5",
		"@turf/boolean-point-in-polygon": "^7.3.5",
		"@turf/buffer": "^7.3.5",
		"@turf/circle": "^7.3.5",
		"@turf/difference": "^7.3.5",
		"@turf/simplify": "^7.3.5",
		"@turf/union": "^7.3.5",
		"compress-csv-to-json": "^0.0.3",
		"cross-env": "^7.0.3",
		"d3-dsv": "^3.0.1",
		"gh-pages": "^6.3.0",
		"idb-keyval": "^6.2.4",
		"install": "^0.13.0",
		"npm": "^11.15.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.2.6",
		"svelte": "^5.55.8",
		"throttleit": "^2.1.0",
		"vite": "^5.4.21"
	},
	"dependencies": {
		"sirv-cli": "^1.0.0"
	},
	"type": "module"
}
