{
	"name": "ons-bacap",
	"homepage": "http://github.com/ONSdigital/BaCAP",
	"version": "3.0.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node ./scripts/js-fix",
		"build:preview": "cross-env PUBLIC_APP_ENV=preview vite build",
		"package": "vite package",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo \"\"",
		"data:get-places": "node ./scripts/get-places-list.js",
		"data:compress": "node ./scripts/compress-data.js",
		"data:lookups": "node ./scripts/make-oa-lookups.js && node ./scripts/make-rgn-cauth-children.js",
		"test": "vitest run",
		"lint": "prettier --ignore-path .gitignore --check --plugin-search-dir=. .",
		"format": "prettier --ignore-path .gitignore --write --plugin-search-dir=. ."
	},
	"author": "Ahmad Barclay",
	"license": "MIT",
	"devDependencies": {
		"@mapbox/mapbox-gl-draw": "^1.4.3",
		"@mapbox/tilebelt": "^2.0.3",
		"@onsvisual/accessible-xlsx": "^0.2.1",
		"@onsvisual/svelte-components": "^1.1.59",
		"@onsvisual/svelte-maps": "^2.0.3",
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@turf/area": "^7.3.5",
		"@turf/bbox": "^7.3.5",
		"@turf/boolean-point-in-polygon": "^7.3.5",
		"@turf/buffer": "^7.3.5",
		"@turf/circle": "^7.3.5",
		"@turf/difference": "^7.3.5",
		"@turf/simplify": "^7.3.5",
		"@turf/union": "^7.3.5",
		"@zumer/snapdom": "^2.12.8",
		"compress-csv-to-json": "^0.0.3",
		"cross-env": "^7.0.3",
		"d3-dsv": "^3.0.1",
		"d3-scale": "^4.0.2",
		"idb-keyval": "^6.2.4",
		"install": "^0.13.0",
		"markdown-it": "^14.2.0",
		"npm": "^11.15.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.2.6",
		"proj4": "^2.22.0",
		"pym.js": "^1.3.2",
		"svelte": "^5.55.8",
		"throttleit": "^2.1.0",
		"vite": "^7.3.6",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"sirv-cli": "^1.0.0"
	},
	"type": "module"
}
